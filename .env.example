# ===== السيرفر =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== قاعدة البيانات =====
# محلي: mongodb://127.0.0.1:27017/digital_adstore
# أو من MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/digital_adstore

# ===== الحماية =====
JWT_SECRET=غيّر_القيمة_دي_لسلسلة_عشوائية_طويلة
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=غيّر_القيمة_دي_كمان
JWT_REFRESH_EXPIRES_IN=30d

# ===== كوكي الجلسة =====
# لو الواجهة (هوستنجر) والـ API (Render) على دومينين مختلفين تمامًا —
# يعني بتستخدم رابط Render الخام (xxx.onrender.com) مش دومين فرعي —
# لازم تحط هنا:
# COOKIE_SAMESITE=none
#     ← شغّال عادي على كروم/إيدج/فايرفوكس. الاستثناء الوحيد سفاري، بيمنع
#     كوكيز الدومينات المختلفة افتراضيًا (ITP). لو ده يهمك، الحل دومين
#     فرعي للـ API (api.digitalad.sa) — تفاصيله في الـ README.
#
# سيبه فاضي (lax) بس لو الواجهة والـ API فعلاً تحت نفس الدومين
# (مثلاً عن طريق دومين فرعي).

# سيبه فاضي في الحالة العادية.
# املاه بس لو محتاج الكوكي يشتغل على أكتر من دومين فرعي: .digitalad.sa
# COOKIE_DOMAIN=

# ===== رفع الملفات =====
UPLOADS_DIR=uploads

# ===== الإيميل (إشعارات + استعادة كلمة المرور) =====
# سيبها فاضية والسيستم هيشتغل عادي، بس الإيميلات مش هتتبعت
# والروابط هتتطبع في كونسول السيرفر بدل ما تتبعت (مفيد وقت التطوير).
#
# Gmail:          SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
#                 SMTP_PASS = App Password من إعدادات أمان جوجل (مش باسورد الحساب)
# Zoho:           SMTP_HOST=smtp.zoho.com    SMTP_PORT=465  SMTP_SECURE=true
# Brevo/Sendgrid: من لوحة الخدمة
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# الاسم والعنوان اللي بيظهروا للعميل
MAIL_FROM=Digital AD <no-reply@digitalad.sa>
# لو العميل ضغط "رد" الرسالة تروح فين (اختياري)
MAIL_REPLY_TO=

# الإيميل اللي توصله إشعارات الإدارة (طلب جديد / عرض سعر / رسالة تواصل)
# لو سيبته فاضي بيستخدم ADMIN_EMAIL تحت
ADMIN_NOTIFY_EMAIL=

# مدة صلاحية رابط استعادة كلمة المرور بالدقايق
PASSWORD_RESET_MINUTES=60

# ===== بوابة الدفع (مرحلة لاحقة) =====
# MOYASAR_SECRET_KEY=
# MOYASAR_PUBLISHABLE_KEY=

# ===== أول حساب مدير (للسكربت npm run seed:admin) =====
ADMIN_NAME=مدير النظام
ADMIN_EMAIL=admin@digitalad.sa
ADMIN_PASSWORD=غيّرها_لكلمة_مرور_قوية

# ===== تخزين الصور =====
# cloudinary (الافتراضي) أو local
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=digital-adstore
